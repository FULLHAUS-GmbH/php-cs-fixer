{
    "name": "fullhaus/php-cs-fixer",
    "description": "Default PHP-CS-Fixer configuration for FULLHAUS projects.",
    "license": "MIT",
    "type": "library",
    "readme": "README.md",
    "homepage": "https://www.fullhaus.de/",
    "require": {
        "php": ">=8.0",
        "friendsofphp/php-cs-fixer": "^3.95.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "phpunit/phpunit": ">=9.6.34"
    },
    "autoload": {
        "psr-4": {
            "FULLHAUS\\CodingStandards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FULLHAUS\\CodingStandards\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "lock": false
    },
    "scripts": {
        "format": "php-cs-fixer",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/"
    }
}
